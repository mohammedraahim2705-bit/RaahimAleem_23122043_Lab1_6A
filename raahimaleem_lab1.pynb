          "name": "stdout",
          "text": [
            "===== TRAVEL AGENT =====\n"
          ]
        }
      ],
      "source": [
        "print(\"===== TRAVEL AGENT =====\")\n",
        "\n",
        "destination = input(\"Which place do you want to visit? \")\n",
        "budget = int(input(\"Enter your travel budget in PKR: \"))\n",
        "\n",
        "if destination.lower() == \"hunza\":\n",
        "    if budget >= 45000:\n",
        "        print(\"You can travel to Hunza with this budget.\")\n",
        "        print(\"Recommended places: Attabad Lake, Altit Fort\")\n",
        "    else:\n",
        "        print(\"Your budget is not enough for a Hunza trip.\")\n",
        "\n",
        "elif destination.lower() == \"skardu\":\n",
        "    if budget >= 55000:\n",
        "        print(\"You can travel to Skardu with this budget.\")\n",
        "        print(\"Recommended places: Shangrila, Deosai\")\n",
        "    else:\n",
        "        print(\"Your budget is not enough for a Skardu trip.\")\n",
        "\n",
        "elif destination.lower() == \"swat\":\n",
        "    if budget >= 35000:\n",
        "        print(\"You can travel to Swat with this budget.\")\n",
        "        print(\"Recommended places: Kalam, Malam Jabba\")\n",
        "    else:\n",
        "        print(\"Your budget is not enough for a Swat trip.\")\n",
        "\n",
        "else:\n",
        "    print(\"Sorry! This destination is not available.\")\n",
        "    print(\"Please choose Hunza, Skardu, or Swat.\")\n",
        "\n",
        "print(\"Thank you for using Travel Agent!\")"
      ]
    }
  ]
}